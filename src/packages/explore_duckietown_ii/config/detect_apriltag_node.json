{
"debug_image_topics":[
    "/debug/apriltag_location"
],

"parameters":{
    "apriltag":{
        "family":            {"default": "tagStandard52h13"},
        "nthreads":          {"default": 4,    "min": 1,   "max": 8},
        "quad_decimate":     {"default": 1.0,  "min": 0.5, "max": 4.0},
        "quad_sigma":        {"default": 0.0,  "min": 0.0, "max": 2.0},
        "refine_edges":      {"default": 1,    "min": 0,   "max": 1},
        "decode_sharpening": {"default": 0.25, "min": 0.0, "max": 1.0},
        "debug":             {"default": 0,    "min": 0,   "max": 1}
    },

    "roi":{
        "width": {"default": 0.0, "min": 0.0, "max": 1.0}
    },

    "crop_image":{
        "crop_im_size": {"default": 300, "min": 100, "max": 640}
    }
}
}
